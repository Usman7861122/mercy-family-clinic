---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { nav, site } from "../lib/site";
import { contactHref } from "../lib/links";

interface Props { solid?: boolean }
const { solid = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
const cta = contactHref(Astro.url);
---

<header id="site-header" class="hdr fixed inset-x-0 top-0 z-50" data-solid={solid ? "true" : "false"}>
  <div class="mx-auto flex h-20 w-full max-w-[96rem] items-center justify-between gap-4 px-5 sm:px-8 lg:px-8 xl:px-10">
    <a href="/" aria-label="Mercy Family Clinic, home" class="hdr-fg shrink-0">
      <Logo class="!h-10 xl:!h-11" />
    </a>

    <nav aria-label="Main" class="hidden min-w-0 lg:block">
      <ul class="flex items-center gap-5 xl:gap-8 2xl:gap-10">
        {nav.map((item, i) => {
          const active = isActive(item.href);
          return item.children ? (
            <li class="dd relative" data-dropdown>
              <div class="flex items-center">
                <a href={item.href} class="hdr-fg hdr-link font-heading text-sm font-medium" data-active={active} aria-current={active ? "page" : undefined}>{item.label}</a>
                <button type="button" class="hdr-fg dd-btn ml-0.5 flex h-8 w-8 items-center justify-center rounded-full" aria-expanded="false" aria-controls={`dd-${i}`} aria-label={`${item.label} submenu`}>
                  <Icon name="chevron" class="h-4 w-4 transition-transform duration-300" />
                </button>
              </div>
              <div id={`dd-${i}`} class="dd-panel">
                <div class:list={["rounded-2xl bg-cream p-3 shadow-2xl shadow-brand-950/20 ring-1 ring-brand-900/10", item.children.length > 4 ? "w-[34rem]" : "w-72"]}>
                  <ul class:list={["grid gap-1", item.children.length > 4 && "grid-cols-2"]}>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class="flex items-center gap-3 rounded-xl p-3 text-brand-950 transition hover:bg-brand-100/70" aria-current={isActive(c.href) && c.href !== item.href ? "page" : undefined} data-active={isActive(c.href)}>
                          {c.icon && <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700"><Icon name={c.icon} class="h-5 w-5" /></span>}
                          <span class="font-heading text-sm font-medium leading-snug">{c.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {item.children.length > 4 && (
                    <div class="mt-3 flex items-center justify-between gap-4 rounded-xl bg-brand-900 px-5 py-4 text-white">
                      <a href={item.href} class="inline-flex items-center gap-2 font-heading text-sm font-medium hover:text-gold">View all services<Icon name="arrow" class="h-4 w-4" /></a>
                      <a href={site.phoneHref} class="inline-flex items-center gap-2 text-sm text-brand-100 hover:text-white"><Icon name="phone" class="h-4 w-4 text-gold" />{site.phone}</a>
                    </div>
                  )}
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a href={item.href} class="hdr-fg hdr-link font-heading text-sm font-medium" data-active={active} aria-current={active ? "page" : undefined}>{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-3 xl:gap-5">
      <a href={site.phoneHref} class="hdr-fg hidden items-center gap-2 whitespace-nowrap font-heading text-sm font-medium 2xl:inline-flex">
        <Icon name="phone" class="h-4 w-4" />
        {site.phone}
      </a>
      <a href={cta} class="btn btn-primary hidden !min-h-11 !px-5 sm:inline-flex xl:!px-6"><Icon name="calendar" class="h-4 w-4" /><span class="hidden xl:inline">Request Appointment</span><span class="xl:hidden">Book a visit</span></a>
      <button
        id="menu-btn"
        type="button"
        class="hdr-fg inline-flex h-12 w-12 items-center justify-center rounded-full lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" class="m-open h-6 w-6" />
        <Icon name="close" class="m-close hidden h-6 w-6" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden max-h-[calc(100svh-5rem)] overflow-y-auto border-t border-brand-900/10 bg-cream lg:hidden">
    <nav aria-label="Mobile" class="container-page py-4">
      <ul>
        {nav.map((item) => {
          const active = isActive(item.href);
          return (
            <li class="border-b border-brand-900/10">
              {item.children ? (
                <details class="group" open={active}>
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between font-heading text-lg font-medium text-brand-950 [&::-webkit-details-marker]:hidden">
                    <span class:list={[active && "text-brand-600"]}>{item.label}</span>
                    <Icon name="chevron" class="h-5 w-5 transition-transform group-open:rotate-180" />
                  </summary>
                  <ul class="space-y-1 pb-4">
                    {item.href !== item.children[0].href && (
                      <li>
                        <a href={item.href} class="flex min-h-12 items-center gap-3 rounded-xl px-2 font-heading text-base font-medium text-brand-700">All {item.label.toLowerCase()}<Icon name="arrow" class="h-4 w-4" /></a>
                      </li>
                    )}
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class="flex min-h-12 items-center gap-3 rounded-xl px-2 text-brand-950" aria-current={isActive(c.href) ? "page" : undefined}>
                          {c.icon && <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700"><Icon name={c.icon} class="h-4 w-4" /></span>}
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href} class:list={["flex min-h-14 items-center font-heading text-lg font-medium", active ? "text-brand-600" : "text-brand-950"]} aria-current={active ? "page" : undefined}>{item.label}</a>
              )}
            </li>
          );
        })}
      </ul>
      <a href={cta} class="btn btn-primary mt-6 w-full"><Icon name="calendar" class="h-4 w-4" />Request Appointment</a>
      <a href={site.phoneHref} class="btn btn-ghost mb-4 mt-3 w-full"><Icon name="phone" class="h-4 w-4" />Call {site.phone}</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }
  .hdr .hdr-fg { color: #fff; transition: color 0.3s ease; }
  .hdr :global(.logo-img) { transition: filter 0.3s ease; filter: brightness(0) invert(1); }
  .hdr[data-scrolled="true"] :global(.logo-img),
  .hdr[data-solid="true"] :global(.logo-img),
  .hdr[data-open="true"] :global(.logo-img) { filter: none; }

  .hdr-link { position: relative; padding-block: 0.25rem; white-space: nowrap; }
  .hdr-link::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 2px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .hdr-link:hover::after,
  .hdr-link[data-active="true"]::after { transform: scaleX(1); }

  .hdr[data-scrolled="true"],
  .hdr[data-solid="true"],
  .hdr[data-open="true"] {
    background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(18 63 62 / 0.08);
  }
  .hdr[data-scrolled="true"] .hdr-fg,
  .hdr[data-solid="true"] .hdr-fg,
  .hdr[data-open="true"] .hdr-fg { color: var(--color-brand-950); }

  /* Dropdown */
  .dd-panel {
    position: absolute;
    left: 50%;
    top: 100%;
    padding-top: 1rem;
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, 8px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  @media (hover: hover) {
    .dd:hover .dd-panel { visibility: visible; opacity: 1; transform: translate(-50%, 0); }
    .dd:hover .dd-btn :global(svg) { transform: rotate(180deg); }
  }
  .dd:has(:focus-visible) .dd-panel,
  .dd[data-open="true"] .dd-panel { visibility: visible; opacity: 1; transform: translate(-50%, 0); }
  .dd[data-open="true"] .dd-btn :global(svg) { transform: rotate(180deg); }
  .dd-panel a[data-active="true"] { background: color-mix(in srgb, var(--color-brand-100) 70%, transparent); }
  @media (prefers-reduced-motion: reduce) {
    .dd-panel { transition: none; }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  const onScroll = () =>
    header?.setAttribute("data-scrolled", window.scrollY > 40 ? "true" : "false");
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!header || !btn || !menu) return;
    menu.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    btn.querySelector(".m-open")?.classList.toggle("hidden", open);
    btn.querySelector(".m-close")?.classList.toggle("hidden", !open);
    header.setAttribute("data-open", String(open));
  };
  btn?.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

  // Desktop dropdowns: the arrow button opens them for keyboard and touch users
  const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");
  const closeDropdowns = (except?: Element) =>
    dropdowns.forEach((dd) => {
      if (dd === except) return;
      dd.removeAttribute("data-open");
      dd.querySelector(".dd-btn")?.setAttribute("aria-expanded", "false");
    });
  dropdowns.forEach((dd) => {
    const b = dd.querySelector<HTMLButtonElement>(".dd-btn");
    b?.addEventListener("click", () => {
      const open = dd.getAttribute("data-open") !== "true";
      closeDropdowns(dd);
      dd.toggleAttribute("data-open", open);
      b.setAttribute("aria-expanded", String(open));
    });
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("[data-dropdown]")) closeDropdowns();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    setOpen(false);
    const openDd = document.querySelector<HTMLElement>("[data-dropdown][data-open]");
    closeDropdowns();
    openDd?.querySelector<HTMLElement>(".dd-btn")?.focus();
  });
</script>
