---
import Reveal from "../islands/Reveal";
import Icon from "../Icon.astro";
import { images, unsplash } from "../../lib/site";
import { contactHref } from "../../lib/links";
const cta = contactHref(Astro.url);
---

<section
  class="parallax-window relative isolate flex min-h-[85vh] items-center justify-center px-5 py-24"
  style={`background-image: url(${unsplash(images.parallax, 2400)})`}
  role="img"
  aria-label="Green hills under soft morning clouds"
>
  <div class="absolute inset-0 -z-10 bg-brand-950/30"></div>
  <Reveal client:visible className="w-full max-w-md">
    <div class="rounded-3xl border border-white/25 bg-brand-950/55 p-8 text-center backdrop-blur-md sm:p-10">
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-white/10 text-gold ring-1 ring-gold/50"><Icon name="calendar" class="h-7 w-7" /></span>
      <p class="eyebrow mt-5 !text-gold">Ready when you are</p>
      <h2 class="mt-4 text-2xl font-semibold !text-white sm:text-3xl">Take the first step today.</h2>
      <p class="mt-4 text-sm text-white/85">
        Book a visit with Dr. Izzy. We will call you to confirm a time that works for you.
      </p>
      <a href={cta} class="btn btn-light mt-7"><Icon name="calendar" class="h-4 w-4" />Request Appointment</a>
    </div>
  </Reveal>
</section>
