---
import Reveal from "../islands/Reveal";
import GravityStars from "../islands/GravityStars";
import Icon from "../Icon.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import { doctorImage, site } from "../../lib/site";
import { contactHref } from "../../lib/links";

interface Props { page?: boolean }
const { page = false } = Astro.props;
const cta = contactHref(Astro.url);

const stats = [
  { icon: "award", big: "15+", small: "years in family medicine" },
  { icon: "calendar", big: "2010", small: "clinic founded" },
  { icon: "users", big: "All ages", small: "welcome" },
];
---

<section id="doctor" class:list={["relative isolate overflow-hidden bg-brand-900 pb-20 text-white sm:pb-28", page ? "pt-36 sm:pt-44" : "pt-20 sm:pt-28"]}>
  <div aria-hidden="true" class="absolute -right-40 -top-40 -z-10 h-[40rem] w-[40rem] rounded-full bg-brand-800/60 blur-3xl"></div>

  <!-- Starfield: stars drift and lean toward your cursor. It sits behind the content, so the photo stays clean. -->
  <GravityStars
    client:visible
    className="pointer-events-none absolute inset-0 -z-10"
    color="#faf6ef"
    count={240}
    connectDistance={120}
    tint={0.45}
    glow={6}
    gravity={3}
    starSize={1.6}
  />

  {page && (
    <div class="container-page mb-12">
      <Breadcrumbs crumbs={[{ label: "About Us", href: "/about" }, { label: "Meet Dr. Izzy" }]} />
    </div>
  )}
  <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div>
      <Reveal client:visible>
        <p class="eyebrow !text-gold">Meet your doctor</p>
        {page ? <h1 class="h2 mt-4 !text-white">Meet Dr. Izzy</h1> : <h2 class="h2 mt-4 !text-white">Meet Dr. Izzy</h2>}
        <p class="mt-3 flex items-center gap-2 font-heading text-lg text-brand-200">
          <Icon name="stethoscope" class="h-5 w-5 text-gold" />
          Ebere Israel Azubuike, MD · Family Medicine
        </p>
        <p class="mt-8 max-w-lg text-lg text-brand-100">
          Dr. Izzy is the medical director of Mercy Family Clinic. He strives to build life-long relationships with every member of the family.
        </p>
        <p class="mt-5 max-w-lg text-brand-200">
          He graduated from the University of Texas Medical Branch in 2005, completed his residency at Methodist Health System Dallas in 2008, and opened the clinic in 2010.
        </p>

        <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-white/15 pt-8">
          {stats.map((s) => (
            <div class="hover-pop">
              <span class="icon-pop inline-block"><Icon name={s.icon} class="h-6 w-6 text-gold" /></span>
              <dt class="mt-3 font-heading text-2xl font-semibold text-white sm:text-3xl">{s.big}</dt>
              <dd class="mt-1 text-sm text-brand-200">{s.small}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href={cta} class="btn btn-light"><Icon name="calendar" class="h-4 w-4" />Request Appointment</a>
          <a href={site.phoneHref} class="btn btn-ghost-light"><Icon name="phone" class="h-4 w-4" />Call {site.phone}</a>
        </div>
      </Reveal>
    </div>

    <Reveal client:visible delay={0.1} className="relative mx-auto w-full max-w-md lg:max-w-lg">
      <div aria-hidden="true" class="absolute -right-4 top-6 h-full w-full rounded-t-[999px] rounded-b-[2rem] border border-gold/60 sm:-right-6 sm:top-8"></div>
      <img
        src={doctorImage}
        alt="Dr. Ebere Israel Azubuike, MD"
        width="552"
        height="540"
        loading="lazy"
        class="relative aspect-[4/5] w-full rounded-t-[999px] rounded-b-[2rem] object-cover object-[50%_20%] shadow-2xl shadow-black/30"
      />
      <div class="absolute -bottom-5 left-4 flex items-center gap-3 rounded-2xl bg-cream p-4 pr-6 shadow-xl sm:-left-4">
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-700 text-white"><Icon name="stethoscope" class="h-5 w-5" /></span>
        <span>
          <span class="block font-heading text-sm font-semibold text-brand-950">Dr. Izzy</span>
          <span class="block text-sm text-muted">Medical Director</span>
        </span>
      </div>
    </Reveal>
  </div>
</section>
