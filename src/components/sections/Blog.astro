---
import Reveal from "../islands/Reveal";
import Icon from "../Icon.astro";
import { getPosts } from "../../lib/blog";

interface Props { count?: number; heading?: boolean }
const { count = 3, heading = true } = Astro.props;
const posts = await getPosts(count);
const fmt = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<section id="blog" class="section-pad bg-sand/60">
  <div class="container-page">
    {heading && (
      <Reveal client:visible className="mx-auto max-w-2xl text-center">
        <p class="eyebrow">From our blog</p>
        <h2 class="h2 mt-4">Health tips for your family</h2>
        <p class="mt-5 text-lg text-muted">Simple, helpful reading from Dr. Izzy and the team.</p>
      </Reveal>
    )}

    <div class:list={["grid gap-8 md:grid-cols-3", heading && "mt-14"]}>
      {posts.map((post, i) => (
        <Reveal client:visible delay={i * 0.1}>
          <article class="group relative flex h-full flex-col">
            <div class="relative overflow-hidden rounded-2xl">
              <img
                src={post.image}
                alt=""
                loading="lazy"
                width="800"
                height="560"
                class="aspect-[10/7] w-full object-cover transition duration-700 group-hover:scale-105"
              />
              {post.sample && (
                <span class="absolute left-4 top-4 rounded-full bg-cream/95 px-3 py-1 font-heading text-xs font-medium text-brand-800">Sample post</span>
              )}
            </div>
            <time datetime={post.date} class="mt-6 text-sm text-brand-600">{fmt.format(new Date(post.date))}</time>
            <h3 class="mt-2 text-xl font-semibold leading-snug">
              {post.href ? (
                <a href={post.href} class="after:absolute after:inset-0 hover:text-brand-700">{post.title}</a>
              ) : (
                post.title
              )}
            </h3>
            <p class="mt-3 line-clamp-3 text-muted">{post.excerpt}</p>
            {post.href && (
              <span class="mt-5 inline-flex items-center gap-2 font-heading text-sm font-medium text-brand-700">
                Read article <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
              </span>
            )}
          </article>
        </Reveal>
      ))}
    </div>
  </div>
</section>
