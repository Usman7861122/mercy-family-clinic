---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import Reveal from "../../components/islands/Reveal";
import WhyMercy from "../../components/sections/WhyMercy.astro";
import Doctor from "../../components/sections/Doctor.astro";
import ParallaxCta from "../../components/sections/ParallaxCta.astro";

const pillars = [
  { icon: "users", title: "Family medicine", text: "Prevention, diagnosis and treatment of common health conditions for patients of all ages." },
  { icon: "heart-pulse", title: "Chronic care", text: "Specialized care for conditions like diabetes and hypertension, with personal treatment plans." },
  { icon: "scale", title: "Weight loss", text: "Medically supervised weight loss programs and disease management support." },
  { icon: "shield", title: "Preventive care", text: "Immunizations, physical exams and in-office diagnostic testing, including physicals for work and school." },
];
---

<BaseLayout
  title="About Us | Mercy Family Clinic"
  description="Mercy Family Clinic is a primary care clinic in Dallas, TX led by Medical Director Ebere Israel Azubuike, MD."
>
  <PageHero
    eyebrow="About us"
    title="Building lasting relationships with families"
    description="Mercy Family Clinic is a comprehensive primary care clinic led by Medical Director Ebere Israel Azubuike, MD. We serve patients of all ages in Dallas, Texas and nearby areas."
    crumbs={[{ label: "About Us" }]}
  />

  <section class="section-pad pb-0">
    <div class="container-page">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p, i) => (
          <Reveal client:visible delay={i * 0.08} className="h-full">
            <div class="lift h-full rounded-3xl bg-white p-8 shadow-lg shadow-brand-900/5 ring-1 ring-brand-900/5">
              <span class="icon-pop flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-brand-700"><Icon name={p.icon} class="h-7 w-7" /></span>
              <h2 class="mt-6 text-xl font-semibold">{p.title}</h2>
              <p class="mt-3 text-muted">{p.text}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <WhyMercy />
  <Doctor />
  <ParallaxCta />
</BaseLayout>
